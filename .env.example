# Copy this file to .env and fill in the values you need.
# .env is ignored by git, so your keys never end up in the repository.

# Which language model provider to use: openai or anthropic
WANDERLUST_LLM_PROVIDER=openai

# Optional: override the provider's default model
# WANDERLUST_LLM_MODEL=

# Optional: thinking effort (low, medium, high, xhigh, max)
# WANDERLUST_LLM_EFFORT=

# Semantic search: auto (OpenAI if OPENAI_API_KEY is set, else a local model
# if installed with `pip install "wanderlust[local]"`), openai, local or none
WANDERLUST_EMBEDDING_PROVIDER=auto
# WANDERLUST_EMBEDDING_MODEL=

# API key for the provider you chose above (only that one is required).
# Leave a key empty if you don't have it: an empty value counts as "not set".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Wikivoyage language edition (en, de, fr, ...)
WANDERLUST_WIKIVOYAGE_LANGUAGE=en

# Where cached guides and search indexes are stored
WANDERLUST_DATA_DIR=.wanderlust

# Hours before a cached guide is downloaded again (168 = one week)
WANDERLUST_WIKIVOYAGE_CACHE_TTL_HOURS=168
